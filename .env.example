# Database
DATABASE_URL="postgresql://tms:tms_password@localhost:5432/tms?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# API
API_PORT=3001
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# Web Dashboard
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
WEB_PORT=3000

# Tenant Portal
NEXT_PUBLIC_PORTAL_API_URL="http://localhost:3001/api/v1"
PORTAL_PORT=3002

# File Storage (S3-compatible)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="tms-documents"
S3_REGION="af-south-1"

# Email (SendGrid)
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@tms.co.za"

# SMS (Africa's Talking)
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""
