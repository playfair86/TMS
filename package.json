{
  "name": "tms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Residential Multifamily Tenant Management System",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @tms/api dev",
    "dev:web": "pnpm --filter @tms/web dev",
    "dev:portal": "pnpm --filter @tms/portal dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @tms/database generate",
    "db:migrate": "pnpm --filter @tms/database migrate",
    "db:push": "pnpm --filter @tms/database push",
    "db:seed": "pnpm --filter @tms/database seed",
    "db:studio": "pnpm --filter @tms/database studio",
    "clean": "pnpm -r exec rm -rf node_modules dist .next .turbo"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core"
    ]
  }
}
